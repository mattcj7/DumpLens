# Normalize text files in Git and apply explicit line endings where needed.
* text=auto

*.cs text eol=crlf
*.xaml text eol=crlf
*.xml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.txt text eol=crlf
*.sql text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.db binary
*.sqlite binary
*.duckdb binary
*.xlsx binary
*.xls binary
*.docx binary
*.pptx binary
