                    </Border>

                    <Border Margin="0,16,0,0"
                            Padding="14"
                            Background="White"
                            BorderBrush="#FFD6DCE3"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasSourceContext, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock FontWeight="SemiBold" Text="Source Import" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding SourceImportIdDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Source Name" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Text="{Binding SourceNameDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Source Type" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="12,0,0,0" Text="{Binding SourceTypeDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Platform" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="12,0,0,0" Text="{Binding PlatformDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Original File" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="12,0,0,0" Text="{Binding OriginalFilenameDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="Source Artifact" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Margin="12,0,0,0" Text="{Binding SourceArtifactIdDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="6" FontWeight="SemiBold" Text="Artifact Locator" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Margin="12,0,0,0" Text="{Binding ArtifactLocatorDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="7" FontWeight="SemiBold" Text="Provider Message" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Margin="12,0,0,0" Text="{Binding ProviderMessageIdDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="8" FontWeight="SemiBold" Text="Source Thread" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Margin="12,0,0,0" Text="{Binding SourceThreadIdDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="9" FontWeight="SemiBold" Text="Message Hash" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Margin="12,0,0,0" Text="{Binding MessageHashPrefixDisplay, Mode=OneWay}" TextWrapping="Wrap" />
