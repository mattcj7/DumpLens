<Window x:Class="DumpLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DumpLens.App"
        xmlns:vm="clr-namespace:DumpLens.App.ViewModels;assembly=DumpLens.App.ViewModels"
        Title="DumpLens"
        Width="1500"
        Height="900"
        MinWidth="1200"
        MinHeight="720"
        Background="#FFF5F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate DataType="{x:Type vm:PlaceholderWorkspaceViewModel}">
            <Grid Margin="0,24,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="16"
                        Background="#FFF7F8FA"
                        BorderBrush="#FFD6DCE3"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Current status" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#FF52606D"
                                   Text="{Binding BodyText, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,16,0,0"
                        Padding="16"
                        Background="#FFF7F8FA"
                        BorderBrush="#FFD6DCE3"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="What comes later" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#FF52606D"
                                   Text="{Binding NextStepText, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,16,0,0"
                        Padding="16"
                        Background="#FFFDF5E8"
                        BorderBrush="#FFEAC46A"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Foreground="#FF6B4E16"
                               Text="Placeholder only. This shell does not connect to live cases, imports, AI results, reconciliation, reports, or audit workflows yet."
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SourceManagerViewModel}">
            <Grid Margin="0,24,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="14"
                        Background="#FFF7F8FA"
                        BorderBrush="#FFD6DCE3"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="Sources" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#FF52606D"
                                       Text="{Binding SourceCount, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Records" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#FF52606D"
                                       Text="{Binding TotalRecordCount, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Warnings" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#FF52606D"
                                       Text="{Binding TotalWarningCount, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,16,0,0"
                        Padding="14"
                        Background="#FFEEF6FF"
                        BorderBrush="#FFBDD6F6"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock Foreground="#FF1D4E89"
                               Text="{Binding StatusMessage, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="2"
                      Margin="0,16,0,0">
                    <Border Padding="16"
                            Background="#FFF7F8FA"
                            BorderBrush="#FFD6DCE3"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding IsEmptyStateVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="#FF52606D"
                                   Text="{Binding EmptyStateMessage, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Padding="16"
                            Background="#FFFFF4F4"
                            BorderBrush="#FFF3B0B0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="#FF8A1C1C"
                                   Text="{Binding ErrorMessage, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid Visibility="{Binding HasSources, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid ItemsSource="{Binding Sources, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Source"
                                                    Binding="{Binding SourceName, Mode=OneWay}"
                                                    Width="2*" />
                                <DataGridTextColumn Header="Type"
                                                    Binding="{Binding SourceType, Mode=OneWay}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Platform"
                                                    Binding="{Binding PlatformDisplay, Mode=OneWay}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding ImportStatus, Mode=OneWay}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Records"
                                                    Binding="{Binding RecordCount, Mode=OneWay}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Warnings"
                                                    Binding="{Binding WarningCount, Mode=OneWay}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Imported"
                                                    Binding="{Binding ImportedAtDisplay, Mode=OneWay}"
                                                    Width="1.6*" />
                                <DataGridTextColumn Header="File"
                                                    Binding="{Binding OriginalFilename, Mode=OneWay}"
                                                    Width="1.6*" />
                                <DataGridTextColumn Header="Bytes"
                                                    Binding="{Binding FileSizeDisplay, Mode=OneWay}"
                                                    Width="*" />
                                <DataGridTextColumn Header="SHA-256"
                                                    Binding="{Binding HashPrefix, Mode=OneWay}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SearchWorkspaceViewModel}">
            <Grid Margin="0,24,0,0">
                <Border Padding="18"
                        Background="#FFF7F8FA"
                        BorderBrush="#FFD6DCE3"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding IsNoActiveCaseVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Foreground="#FF52606D"
                               Text="Create or open a case to search messages."
                               TextWrapping="Wrap" />
                </Border>

                <Grid Visibility="{Binding HasActiveCase, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="16"
                            Background="#FFF7F8FA"
                            BorderBrush="#FFD6DCE3"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Message Search" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#FF52606D"
                                       Text="Search imported messages in the active case. Rebuild the search index if this case has new imports or if results seem incomplete."
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Margin="0,0,12,0"
                                         Padding="10,8"
                                         IsEnabled="{Binding CanEditSearchQuery, Mode=OneWay}"
                                         Text="{Binding SearchQueryText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Margin="0,0,12,0"
                                        Padding="16,8"
                                        Command="{Binding SearchCommand}"
                                        Content="Search" />
                                <Button Grid.Column="2"
                                        Padding="16,8"
                                        Command="{Binding RebuildSearchIndexCommand}"
                                        Content="Rebuild Search Index" />
                            </Grid>

                            <Border Margin="0,14,0,0"
                                    Padding="12"
                                    Background="#FFEEF6FF"
                                    BorderBrush="#FFBDD6F6"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock Foreground="#FF1D4E89"
                                           Text="{Binding SearchResultCount, Mode=OneWay, StringFormat=Results: {0}}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,16,0,0"
                            Padding="14"
                            Background="#FFEEF6FF"
                            BorderBrush="#FFBDD6F6"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Foreground="#FF1D4E89"
                                   Text="{Binding StatusMessage, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid Grid.Row="2"
                          Margin="0,16,0,0">
                        <Border Padding="16"
                                Background="#FFFFF4F4"
                                BorderBrush="#FFF3B0B0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding HasError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="#FF8A1C1C"
                                       Text="{Binding ErrorMessage, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Padding="16"
                                Background="#FFFDF5E8"
                                BorderBrush="#FFEAC46A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding HasValidationMessage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="#FF6B4E16"
                                       Text="{Binding ValidationMessage, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Padding="16"
                                Background="White"
                                BorderBrush="#FFD6DCE3"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding IsResultsEmptyStateVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="#FF52606D"
                                       Text="{Binding ResultsEmptyStateMessage, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <ListBox ItemsSource="{Binding Results, Mode=OneWay}"
                                 SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 Visibility="{Binding HasResults, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12"
                                            Padding="14"
                                            Background="White"
                                            BorderBrush="#FFD6DCE3"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <WrapPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding TimestampDisplay, Mode=OneWay}" />
                                                <TextBlock Margin="12,0,0,0"
                                                           Foreground="#FF52606D"
                                                           Text="{Binding PlatformDisplay, Mode=OneWay}" />
                                                <TextBlock Margin="12,0,0,0"
                                                           Foreground="#FF52606D"
                                                           Text="{Binding DirectionDisplay, Mode=OneWay}" />
                                                <TextBlock Margin="12,0,0,0"
                                                           Foreground="#FF52606D"
                                                           Text="{Binding DeletedStatusDisplay, Mode=OneWay}" />
                                                <TextBlock Margin="12,0,0,0"
                                                           Foreground="#FF52606D"
                                                           Text="{Binding RankDisplay, Mode=OneWay}" />
                                            </WrapPanel>

                                            <TextBlock Margin="0,10,0,0"
                                                       Text="{Binding SnippetDisplay, Mode=OneWay}"
                                                       TextWrapping="Wrap" />

                                            <WrapPanel Margin="0,10,0,0">
                                                <TextBlock Foreground="#FF52606D"
                                                           Text="{Binding ConversationDisplay, Mode=OneWay}" />
                                                <TextBlock Margin="12,0,0,0"
                                                           Foreground="#FF52606D"
                                                           Text="{Binding SourceImportDisplay, Mode=OneWay}" />
                                                <TextBlock Margin="12,0,0,0"
                                                           Foreground="#FF52606D"
                                                           Text="{Binding SourceArtifactDisplay, Mode=OneWay}" />
                                                <TextBlock Margin="12,0,0,0"
                                                           Foreground="#FF52606D"
                                                           Text="{Binding SourceThreadDisplay, Mode=OneWay}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ConversationWorkspaceViewModel}">
            <Grid Margin="0,24,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="14"
                        Background="#FFEEF6FF"
                        BorderBrush="#FFBDD6F6"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock Foreground="#FF1D4E89"
                               Text="{Binding StatusMessage, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="1"
                      Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="16"
                            Background="#FFF7F8FA"
                            BorderBrush="#FFD6DCE3"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Conversation List" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="#FF52606D"
                                           Text="{Binding ConversationCount, Mode=OneWay, StringFormat=Loaded conversations: {0}}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Grid.Row="1"
                                       Margin="0,12,0,0"
                                       Foreground="#FF52606D"
                                       Text="Select a conversation to review its thread and safe metadata."
                                       TextWrapping="Wrap" />

                            <Grid Grid.Row="2"
                                  Margin="0,16,0,0">
                                <Border Padding="16"
                                        Background="#FFFFF4F4"
                                        BorderBrush="#FFF3B0B0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding HasConversationListError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Foreground="#FF8A1C1C"
                                               Text="{Binding ConversationListErrorMessage, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <Border Padding="16"
                                        Background="White"
                                        BorderBrush="#FFD6DCE3"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding IsConversationListEmptyStateVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Foreground="#FF52606D"
                                               Text="{Binding ConversationListEmptyStateMessage, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <DataGrid ItemsSource="{Binding Conversations, Mode=OneWay}"
                                          SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          RowHeaderWidth="0"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          ScrollViewer.CanContentScroll="True"
                                          Visibility="{Binding HasConversations, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Title"
                                                            Binding="{Binding Title, Mode=OneWay}"
                                                            Width="2.4*" />
                                        <DataGridTextColumn Header="Platform"
                                                            Binding="{Binding PlatformDisplay, Mode=OneWay}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="End"
                                                            Binding="{Binding EndTimeDisplay, Mode=OneWay}"
                                                            Width="1.7*" />
                                        <DataGridTextColumn Header="Messages"
                                                            Binding="{Binding MessageCountDisplay, Mode=OneWay}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="Sources"
                                                            Binding="{Binding SourceCountDisplay, Mode=OneWay}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="Review"
                                                            Binding="{Binding ReviewStatus, Mode=OneWay}"
                                                            Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="16"
                            Background="#FFF8FAFC"
                            BorderBrush="#FFD6DCE3"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Thread View" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="#FF52606D"
                                           Text="{Binding ThreadStatusMessage, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Margin="0,16,0,0"
                                    Padding="14"
                                    Background="White"
                                    BorderBrush="#FFD6DCE3"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding HasSelectedConversation, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock FontWeight="SemiBold" Text="Title" />
                                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding SelectedConversation.Title, Mode=OneWay}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Platform" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Text="{Binding SelectedConversation.PlatformDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Time Range" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="12,0,0,0" Text="{Binding SelectedConversation.StartTimeDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="12,0,0,0" Text="{Binding SelectedConversation.EndTimeDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Counts" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="12,0,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding SelectedConversation.MessageCountDisplay, Mode=OneWay}" />
                                        <Run Text=" messages, " />
                                        <Run Text="{Binding SelectedConversation.SourceCountDisplay, Mode=OneWay}" />
                                        <Run Text=" sources, " />
                                        <Run Text="{Binding SelectedConversation.GapCountDisplay, Mode=OneWay}" />
                                        <Run Text=" gaps, priority " />
                                        <Run Text="{Binding SelectedConversation.PriorityScoreDisplay, Mode=OneWay}" />
                                        <Run Text=", " />
                                        <Run Text="{Binding SelectedConversation.ReconciliationStatus, Mode=OneWay}" />
                                        <Run Text=", " />
                                        <Run Text="{Binding SelectedConversation.ReviewStatus, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2"
                                  Margin="0,16,0,0">
                                <Border Padding="16"
                                        Background="#FFFFF4F4"
                                        BorderBrush="#FFF3B0B0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding HasThreadError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Foreground="#FF8A1C1C"
                                               Text="{Binding ThreadErrorMessage, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <Border Padding="16"
                                        Background="White"
                                        BorderBrush="#FFD6DCE3"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding IsThreadEmptyStateVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Foreground="#FF52606D"
                                               Text="{Binding ThreadEmptyStateMessage, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <ListBox ItemsSource="{Binding ThreadMessages, Mode=OneWay}"
                                         SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         Visibility="{Binding HasThreadMessages, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,12"
                                                    Padding="14"
                                                    Background="White"
                                                    BorderBrush="#FFD6DCE3"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel>
                                                    <WrapPanel>
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding TimestampDisplay, Mode=OneWay}" />
                                                        <TextBlock Margin="12,0,0,0"
                                                                   Foreground="#FF52606D"
                                                                   Text="{Binding DirectionDisplay, Mode=OneWay}" />
                                                        <TextBlock Margin="12,0,0,0"
                                                                   Foreground="#FF52606D"
                                                                   Text="{Binding PlatformDisplay, Mode=OneWay}" />
                                                        <TextBlock Margin="12,0,0,0"
                                                                   Foreground="#FF52606D"
                                                                   Text="{Binding DeletedStatus, Mode=OneWay}" />
                                                        <Border Margin="12,0,0,0"
                                                                Padding="8,2"
                                                                Background="#FFEEF6FF"
                                                                BorderBrush="#FFBDD6F6"
                                                                BorderThickness="1"
                                                                CornerRadius="10">
                                                            <TextBlock Foreground="#FF1D4E89"
                                                                       Text="{Binding SourceReferenceIndicator, Mode=OneWay}" />
                                                        </Border>
                                                    </WrapPanel>

                                                    <TextBlock Margin="0,10,0,0"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding SenderDisplayLabel, Mode=OneWay}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="#FF52606D"
                                                               Text="{Binding RecipientsDisplay, Mode=OneWay}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,10,0,0"
                                                               Text="{Binding MessageBody, Mode=OneWay}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InspectorPlaceholderViewModel}">
            <Border Margin="0,20,0,0"
                    Padding="14"
                    Background="White"
                    BorderBrush="#FFD6DCE3"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="Reserved for" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF52606D"
                               Text="{Binding BodyText, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SourceDetailViewModel}">
