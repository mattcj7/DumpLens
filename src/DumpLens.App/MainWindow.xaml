                                <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Source Metadata" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Text="{Binding SourceMetadataIndicator, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0"
                            Padding="14"
                            Background="White"
                            BorderBrush="#FFD6DCE3"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasSource, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
