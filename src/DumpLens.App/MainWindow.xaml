                            <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Timestamp" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Text="{Binding SelectedMessageTimestampDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Direction" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="12,0,0,0" Text="{Binding DirectionDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Participants" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="12,0,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding SelectedMessageSenderDisplay, Mode=OneWay}" />
