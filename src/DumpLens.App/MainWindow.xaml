                                <Run Text="{Binding ConversationSourceCountDisplay, Mode=OneWay}" />
                                <Run Text=" sources, " />
                                <Run Text="{Binding ConversationGapCountDisplay, Mode=OneWay}" />
                                <Run Text=" gaps, priority " />
                                <Run Text="{Binding ConversationPriorityScoreDisplay, Mode=OneWay}" />
                                <Run Text=", " />
                                <Run Text="{Binding ConversationReconciliationStatus, Mode=OneWay}" />
                                <Run Text=", " />
                                <Run Text="{Binding ConversationReviewStatus, Mode=OneWay}" />
