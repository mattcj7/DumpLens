<Window x:Class="DumpLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DumpLens.App"
        xmlns:vm="clr-namespace:DumpLens.App.ViewModels;assembly=DumpLens.App.ViewModels"
        Title="DumpLens"
        Width="1500"
        Height="900"
        MinWidth="1200"
        MinHeight="720"
        Background="#FFF5F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate DataType="{x:Type vm:PlaceholderWorkspaceViewModel}">
            <Grid Margin="0,24,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="16"
                        Background="#FFF7F8FA"
                        BorderBrush="#FFD6DCE3"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Current status" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#FF52606D"
                                   Text="{Binding BodyText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,16,0,0"
                        Padding="16"
                        Background="#FFF7F8FA"
                        BorderBrush="#FFD6DCE3"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="What comes later" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#FF52606D"
                                   Text="{Binding NextStepText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,16,0,0"
                        Padding="16"
                        Background="#FFFDF5E8"
                        BorderBrush="#FFEAC46A"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Foreground="#FF6B4E16"
                               Text="Placeholder only. This shell does not connect to live cases, imports, AI results, reconciliation, reports, or audit workflows yet."
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SourceManagerViewModel}">
            <Grid Margin="0,24,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="14"
                        Background="#FFF7F8FA"
                        BorderBrush="#FFD6DCE3"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="Sources" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#FF52606D"
                                       Text="{Binding SourceCount}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Records" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#FF52606D"
                                       Text="{Binding TotalRecordCount}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Warnings" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#FF52606D"
                                       Text="{Binding TotalWarningCount}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,16,0,0"
                        Padding="14"
                        Background="#FFEEF6FF"
                        BorderBrush="#FFBDD6F6"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock Foreground="#FF1D4E89"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="2"
                      Margin="0,16,0,0">
                    <Border Padding="16"
                            Background="#FFF7F8FA"
                            BorderBrush="#FFD6DCE3"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="#FF52606D"
                                   Text="{Binding EmptyStateMessage}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Padding="16"
                            Background="#FFFFF4F4"
                            BorderBrush="#FFF3B0B0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="#FF8A1C1C"
                                   Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid Visibility="{Binding HasSources, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid ItemsSource="{Binding Sources}"
                                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Source"
                                                    Binding="{Binding SourceName}"
                                                    Width="2*" />
                                <DataGridTextColumn Header="Type"
                                                    Binding="{Binding SourceType}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Platform"
                                                    Binding="{Binding PlatformDisplay}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding ImportStatus}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Records"
                                                    Binding="{Binding RecordCount}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Warnings"
                                                    Binding="{Binding WarningCount}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Imported"
                                                    Binding="{Binding ImportedAtDisplay}"
                                                    Width="1.6*" />
                                <DataGridTextColumn Header="File"
                                                    Binding="{Binding OriginalFilename}"
                                                    Width="1.6*" />
                                <DataGridTextColumn Header="Bytes"
                                                    Binding="{Binding FileSizeDisplay}"
                                                    Width="*" />
                                <DataGridTextColumn Header="SHA-256"
                                                    Binding="{Binding HashPrefix}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InspectorPlaceholderViewModel}">
            <Border Margin="0,20,0,0"
                    Padding="14"
                    Background="White"
                    BorderBrush="#FFD6DCE3"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="Reserved for" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF52606D"
                               Text="{Binding BodyText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SourceDetailViewModel}">
            <ScrollViewer Margin="0,20,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="14"
                            Background="White"
                            BorderBrush="#FFD6DCE3"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBlock Foreground="#FF52606D"
                                   Text="{Binding StateMessage}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Margin="0,16,0,0"
                            Padding="14"
                            Background="White"
                            BorderBrush="#FFD6DCE3"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock FontWeight="SemiBold" Text="Source" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding SourceName}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="ID" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Text="{Binding SourceImportId}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Type" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="12,0,0,0" Text="{Binding SourceType}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Platform" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="12,0,0,0" Text="{Binding PlatformDisplay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="File" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="12,0,0,0" Text="{Binding OriginalFilename}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="Stored Path" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Margin="12,0,0,0" Text="{Binding StoredFilePathDisplay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="6" FontWeight="SemiBold" Text="Bytes" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Margin="12,0,0,0" Text="{Binding FileSizeDisplay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="7" FontWeight="SemiBold" Text="SHA-256" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Margin="12,0,0,0" Text="{Binding FileSha256}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="8" FontWeight="SemiBold" Text="Imported" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Margin="12,0,0,0" Text="{Binding ImportedAtDisplay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="9" FontWeight="SemiBold" Text="Imported By" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Margin="12,0,0,0" Text="{Binding ImportedByUserIdDisplay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="10" FontWeight="SemiBold" Text="Status" />
                            <TextBlock Grid.Row="10" Grid.Column="1" Margin="12,0,0,0" Text="{Binding ImportStatus}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="11" FontWeight="SemiBold" Text="Records" />
                            <TextBlock Grid.Row="11" Grid.Column="1" Margin="12,0,0,0" Text="{Binding RecordCountDisplay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="12" FontWeight="SemiBold" Text="Warnings" />
                            <TextBlock Grid.Row="12" Grid.Column="1" Margin="12,0,0,0" Text="{Binding WarningCountDisplay}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Margin="0,16,0,0"
                            Padding="14"
                            Background="White"
                            BorderBrush="#FFD6DCE3"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="Safe metadata" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock FontWeight="SemiBold" Text="Notes" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding NotesIndicator}" />

                                <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Source Metadata" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Text="{Binding SourceMetadataIndicator}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0"
                            Padding="14"
                            Background="White"
                            BorderBrush="#FFD6DCE3"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="Warning Summary" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#FF52606D"
                                       Text="{Binding WarningSummary.TotalWarnings, StringFormat=Total warnings: {0}}"
                                       TextWrapping="Wrap" />
                            <ItemsControl Margin="0,12,0,0"
                                          ItemsSource="{Binding WarningSummary.WarningCodeCounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding WarningCode}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Count}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20,14"
                Background="#FF1F2933"
                BorderBrush="#FF0F1720"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="{Binding GlobalCaseTitle}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#FFD7DEE7"
                               Text="{Binding GlobalCaseContext}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Margin="0,0,8,0"
                            Padding="14,8"
                            Command="{Binding OpenCaseCreationCommand}"
                            Content="New Case" />
                    <Button Margin="0,0,8,0"
                            Padding="14,8"
                            IsEnabled="False"
                            Content="Search" />
                    <Button Margin="0,0,8,0"
                            Padding="14,8"
                            IsEnabled="False"
                            Content="Date Range" />
                    <Button Margin="0,0,8,0"
                            Padding="14,8"
                            Command="{Binding OpenImportWizardCommand}"
                            Content="Import" />
                    <Button Padding="14,8"
                            IsEnabled="False"
                            Content="Export" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="16"
                    Background="#FFEEF1F4"
                    BorderBrush="#FFD6DCE3"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="Workspaces" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#FF4A5563"
                                   Text="Choose a review workspace. Filters will appear here later when a screen needs them." 
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             Margin="0,16,0,16"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="12"
                                        Background="White"
                                        BorderBrush="#FFD6DCE3"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Label}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="#FF52606D"
                                                   FontSize="12"
                                                   Text="{Binding Summary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2"
                            Padding="12"
                            Background="White"
                            BorderBrush="#FFD6DCE3"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Foreground="#FF52606D"
                                   Text="Workspace filters are not wired in this ticket. The shell keeps this area reserved so the layout stays stable."
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="24"
                    Background="White"
                    BorderBrush="#FFD6DCE3"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Text="{Binding CurrentWorkspace.Title}" />

                    <Border Grid.Row="1"
                            Margin="0,16,0,0"
                            Padding="14"
                            Background="#FFEEF6FF"
                            BorderBrush="#FFBDD6F6"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Foreground="#FF1D4E89"
                                   Text="{Binding ShellStatusMessage}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Grid.Row="2"
                               Margin="0,10,0,0"
                               Foreground="#FF4A5563"
                               FontSize="14"
                               Text="{Binding CurrentWorkspace.Description}"
                               TextWrapping="Wrap" />

                    <ContentControl Grid.Row="3"
                                    Content="{Binding CurrentWorkspace}" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="20"
                    Background="#FFF8FAFC">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="{Binding Inspector.Title}" />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="#FF4A5563"
                               Text="{Binding Inspector.Description}"
                               TextWrapping="Wrap" />

                    <ContentControl Content="{Binding Inspector}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="2"
              Background="#800F1720"
              Visibility="{Binding IsImportWizardOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="1220"
                  MaxHeight="820"
                  Margin="24">
                <local:ImportWizardView DataContext="{Binding ImportWizard}" />
            </Grid>
        </Grid>

        <Grid Grid.RowSpan="2"
              Background="#800F1720"
              Visibility="{Binding IsCaseCreationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="860"
                  MaxHeight="760"
                  Margin="24">
                <Border Background="White"
                        BorderBrush="#FFD6DCE3"
                        BorderThickness="1"
                        CornerRadius="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24"
                              DataContext="{Binding CaseCreation}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock FontSize="24"
                                           FontWeight="SemiBold"
                                           Text="Create Case" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="#FF4A5563"
                                           Text="Create a local case package with the existing case creation service. Fields marked with * are required."
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,16,16">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="Case Number" />
                                    <TextBox x:Name="CaseNumberTextBox"
                                             Margin="0,6,0,0"
                                             Text="{Binding CaseNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#FFB42318"
                                               Text="{Binding ElementName=CaseNumberTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="16,0,0,16">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="Title *" />
                                    <TextBox x:Name="TitleTextBox"
                                             Margin="0,6,0,0"
                                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#FFB42318"
                                               Text="{Binding ElementName=TitleTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,0,16,16">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="Incident Type" />
                                    <TextBox x:Name="IncidentTypeTextBox"
                                             Margin="0,6,0,0"
                                             Text="{Binding IncidentType, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#FFB42318"
                                               Text="{Binding ElementName=IncidentTypeTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="16,0,0,16">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="Timezone" />
                                    <TextBox x:Name="TimezoneTextBox"
                                             Margin="0,6,0,0"
                                             Text="{Binding Timezone, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#FFB42318"
                                               Text="{Binding ElementName=TimezoneTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Grid.Column="0"
                                            Margin="0,0,16,16">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="Incident Start (optional)" />
                                    <TextBox x:Name="IncidentStartTextBox"
                                             Margin="0,6,0,0"
                                             Text="{Binding IncidentStartText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="#FF52606D"
                                               FontSize="12"
                                               Text="Example: 2026-04-28 13:45" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#FFB42318"
                                               Text="{Binding ElementName=IncidentStartTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Grid.Column="1"
                                            Margin="16,0,0,16">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="Incident End (optional)" />
                                    <TextBox x:Name="IncidentEndTextBox"
                                             Margin="0,6,0,0"
                                             Text="{Binding IncidentEndText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="#FF52606D"
                                               FontSize="12"
                                               Text="Example: 2026-04-28 15:15" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#FFB42318"
                                               Text="{Binding ElementName=IncidentEndTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                                </StackPanel>

                                <StackPanel Grid.Row="3"
                                            Grid.Column="0"
                                            Margin="0,0,16,16">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="Lead Investigator" />
                                    <TextBox x:Name="LeadInvestigatorTextBox"
                                             Margin="0,6,0,0"
                                             Text="{Binding LeadInvestigator, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#FFB42318"
                                               Text="{Binding ElementName=LeadInvestigatorTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                                </StackPanel>

                                <StackPanel Grid.Row="3"
                                            Grid.Column="1"
                                            Margin="16,0,0,16">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="Agency" />
                                    <TextBox x:Name="AgencyTextBox"
                                             Margin="0,6,0,0"
                                             Text="{Binding Agency, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#FFB42318"
                                               Text="{Binding ElementName=AgencyTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                                </StackPanel>

                                <StackPanel Grid.Row="4"
                                            Grid.ColumnSpan="2"
                                            Margin="0,0,0,16">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="Location" />
                                    <TextBox x:Name="LocationTextBox"
                                             Margin="0,6,0,0"
                                             Text="{Binding LocationText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#FFB42318"
                                               Text="{Binding ElementName=LocationTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                                </StackPanel>

                                <StackPanel Grid.Row="5"
                                            Grid.ColumnSpan="2">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="Summary" />
                                    <TextBox x:Name="SummaryTextBox"
                                             Margin="0,6,0,0"
                                             AcceptsReturn="True"
                                             Height="96"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#FFB42318"
                                               Text="{Binding ElementName=SummaryTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2"
                                  Margin="0,24,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="Parent/Root Directory *" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="ParentDirectoryTextBox"
                                                 Margin="0,0,12,0"
                                                 Text="{Binding ParentDirectoryPath, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                        <Button Grid.Column="1"
                                                Padding="14,8"
                                                IsEnabled="False"
                                                Content="Browse" />
                                    </Grid>
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="#FF52606D"
                                               FontSize="12"
                                               Text="Enter the existing parent/root directory path directly in this ticket." />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#FFB42318"
                                               Text="{Binding ElementName=ParentDirectoryTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Margin="0,16,0,0">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="Package Folder Name (optional)" />
                                    <TextBox x:Name="RequestedFolderNameTextBox"
                                             Margin="0,6,0,0"
                                             Text="{Binding RequestedPackageFolderName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#FFB42318"
                                               Text="{Binding ElementName=RequestedFolderNameTextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Margin="0,20,0,0">
                                    <TextBlock Foreground="#FFB42318"
                                               FontWeight="SemiBold"
                                               Text="{Binding GeneralErrorMessage}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="#FF1D4E89"
                                               Text="{Binding StatusMessage}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Margin="0,20,0,0"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <Button Margin="0,0,12,0"
                                                Padding="14,8"
                                                Command="{Binding CancelCommand}"
                                                Content="Cancel" />
                                        <Button Padding="16,8"
                                                Command="{Binding SubmitCommand}"
                                                Content="Create Case" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
