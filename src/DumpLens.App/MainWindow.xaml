<Window x:Class="DumpLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DumpLens"
        Width="1500"
        Height="900"
        MinWidth="1200"
        MinHeight="720"
        Background="#FFF5F6F8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20,14"
                Background="#FF1F2933"
                BorderBrush="#FF0F1720"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="{Binding GlobalCaseTitle}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#FFD7DEE7"
                               Text="{Binding CurrentWorkspace.Title}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Margin="0,0,8,0"
                            Padding="14,8"
                            IsEnabled="False"
                            Content="Search" />
                    <Button Margin="0,0,8,0"
                            Padding="14,8"
                            IsEnabled="False"
                            Content="Date Range" />
                    <Button Margin="0,0,8,0"
                            Padding="14,8"
                            IsEnabled="False"
                            Content="Import" />
                    <Button Padding="14,8"
                            IsEnabled="False"
                            Content="Export" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="16"
                    Background="#FFEEF1F4"
                    BorderBrush="#FFD6DCE3"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="Workspaces" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#FF4A5563"
                                   Text="Choose a review workspace. Filters will appear here later when a screen needs them." 
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             Margin="0,16,0,16"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="12"
                                        Background="White"
                                        BorderBrush="#FFD6DCE3"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Label}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="#FF52606D"
                                                   FontSize="12"
                                                   Text="{Binding Summary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2"
                            Padding="12"
                            Background="White"
                            BorderBrush="#FFD6DCE3"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Foreground="#FF52606D"
                                   Text="Workspace filters are not wired in this ticket. The shell keeps this area reserved so the layout stays stable."
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="24"
                    Background="White"
                    BorderBrush="#FFD6DCE3"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Text="{Binding CurrentWorkspace.Title}" />

                    <TextBlock Grid.Row="1"
                               Margin="0,10,0,0"
                               Foreground="#FF4A5563"
                               FontSize="14"
                               Text="{Binding CurrentWorkspace.Description}"
                               TextWrapping="Wrap" />

                    <Grid Grid.Row="2"
                          Margin="0,24,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Padding="16"
                                Background="#FFF7F8FA"
                                BorderBrush="#FFD6DCE3"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Current status" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="#FF52606D"
                                           Text="{Binding CurrentWorkspace.BodyText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,16,0,0"
                                Padding="16"
                                Background="#FFF7F8FA"
                                BorderBrush="#FFD6DCE3"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="What comes later" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="#FF52606D"
                                           Text="{Binding CurrentWorkspace.NextStepText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Margin="0,16,0,0"
                                Padding="16"
                                Background="#FFFDF5E8"
                                BorderBrush="#FFEAC46A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock Foreground="#FF6B4E16"
                                       Text="Placeholder only. This shell does not connect to live cases, imports, AI results, reconciliation, reports, or audit workflows yet."
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="20"
                    Background="#FFF8FAFC">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="{Binding Inspector.Title}" />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="#FF4A5563"
                               Text="{Binding Inspector.Description}"
                               TextWrapping="Wrap" />

                    <Border Margin="0,20,0,0"
                            Padding="14"
                            Background="White"
                            BorderBrush="#FFD6DCE3"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="Reserved for" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#FF52606D"
                                       Text="{Binding Inspector.BodyText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
